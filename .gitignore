venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# ==========================================
# 2. OS 및 IDE 메타데이터
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*Zone.Identifier

# ==========================================
# 3. 압축파일, 백업 및 임시 파일 (절대 차단)
# ==========================================
*.zip
*.tar
*.gz
*.rar
*.bak
*.tmp
*~
backup/
*_backup/
orphan_txt_backup/
code_dump.txt

# ==========================================
# 4. 학습 모델 및 실행 결과
# ==========================================
*.pt
runs/

# ==========================================
# 5. 보안 인증 파일 (절대 차단)
# ==========================================
*.pub
id_*
*.pem
*.key
.ssh/

# ==========================================
# 6. 데이터 및 대용량 파일 전면 차단 (코드와 리포트만 허용)
# ==========================================
# data, reviews, 원본 학습 데이터 폴더 전체 차단 (이미지, txt 절대 푸시 안 됨)
data/
reviews/
이물검출_학습데이터1/
*_labeled/
*_done/

# 단, 요약 대장 및 분석 리포트(csv, md)는 깃 관리에 포함 허용
!manifests/
manifests/**/*.csv
reports/
!reports/
reports/**/*.csv
reports/**/*.md